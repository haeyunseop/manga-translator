# Copy to .env, choose private values. init_env.py generates safe random defaults.
MANGATRANS_PASSWORD=
MANGATRANS_SESSION_SECRET=
# For public HTTPS tunnel set true. Keep false only for local HTTP/LAN development.
MANGATRANS_SECURE_COOKIE=false
# Exact public HTTPS hosts you own or have permission to process. No general website scraper.
MANGATRANS_ALLOWED_HOSTS=
# NLLB weights: CC-BY-NC-4.0, personal/noncommercial use only.
# m2m100 is an available lower-quality MIT-weight alternative.
MANGATRANS_MODEL=nllb
# Optional public site origin, e.g. https://your-domain.example
MANGATRANS_ORIGINS=
